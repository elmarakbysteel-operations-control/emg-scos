# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/emg_scos

# Authentication & Security
JWT_SECRET=your_secure_jwt_secret_key_change_this_in_production
VITE_APP_ID=your_app_id
OWNER_OPEN_ID=owner_id_from_oauth_provider

# OAuth Configuration
OAUTH_SERVER_URL=https://oauth.example.com
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret

# API Configuration
BUILT_IN_FORGE_API_URL=https://api.example.com
BUILT_IN_FORGE_API_KEY=your_api_key

# Environment
NODE_ENV=development
PORT=3000

# Storage (S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name

# Analytics (Optional)
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your_analytics_id

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_DOCUMENT_EXTRACTION=true
ENABLE_NOTIFICATIONS=true
ENABLE_AUDIT_LOG=true
